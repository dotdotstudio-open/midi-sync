{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "baseUrl": ".",
    "paths": {
      "@dotdot/services/midi-sync/contract": ["libs/services/midi-sync/contract/src/index.ts"],
      "@dotdot/services/midi-sync/client": ["libs/services/midi-sync/client/src/index.ts"],
      "@dotdot/services/midi-sync/node": ["libs/services/midi-sync/node/src/index.ts"],
      "@dotdot/services/midi-sync/react": ["libs/services/midi-sync/react/src/index.ts"]
    }
  }
}
